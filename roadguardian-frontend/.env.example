# ======================
# RoadGuardian AI - Frontend Environment Configuration
# ======================

# Backend API Configuration
# In production, set this to your backend domain (e.g., https://api.roadguardian.ai)
# If backend serves the frontend statically, you can set it to the root or relative origin
VITE_API_URL=http://127.0.0.1:8000

# Client Application URL (used for OAuth redirects)
VITE_CLIENT_URL=http://127.0.0.1:5173

# Supabase Authentication & Storage
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-Side AI Features (Camera Live Damage Detection Overlay)
VITE_GEMINI_API_KEY=your-gemini-api-key
